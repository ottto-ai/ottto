  "_comment": "D5 v1 wire contract (report-54 as changed by report-121 + orchestrator: no worktrees block; the legacy projectInstructions option makes claude_mode unknown). Shared by the backend admission tests and the ottto daemon PR: each variant's instruction_inventory is the exact JSON the daemon serializes. 'expected' is the backend inference (instruction_loading.py) and is not sent.",
  "contract_version": "context_footprint_instruction_inventory:v1",
  "request_field": "instruction_inventory",
  "agent_source": "claude-code",
  "skip_limit_bytes": 4194304,
  "max_entries": 200,
  "max_relative_path_chars": 512,
  "daemon_max_block_bytes": 8192,
  "backend_rejects_block_bytes": false,
  "entry_file_names": [
    "AGENTS.md",
    "CLAUDE.md",
    "CLAUDE.local.md"
  ],
  "entry_order": "the root files (.claude/CLAUDE.md, AGENTS.md, CLAUDE.local.md, CLAUDE.md) first in bytewise order, then every other relative_path in bytewise order",
  "observed_comparison": "symlink-resolved (canonical) path of each entry against the canonical paths of the same capture's Project/Local /context rows",
  "claude_mode_values": [
    "claude-md-or-agents-md",
    "claude-md-and-agents-md",
    "unknown"
  ],
  "claude_mode_unknown_when": [
    "a consulted settings file is unreadable or malformed",
    "the two plugin ids disagree",
    "a value outside the two proven ones",
    "options.projectInstructions (legacy) is present under either plugin id"
  ],
  "partial_reasons": [
    "file_cap",
    "size_cap",
    "time_budget",
    "stat_error",
    "git_failed",
    "paths_withheld"
  ],
  "variants": {
    "default_mode": {
      "instruction_inventory": {
        "started_at_root": true,
        "claude_mode": "claude-md-or-agents-md",
